{
  "windsurf.autocompleteSpeed": "default",
  "windsurf.autoExecutionPolicy": "off",
  "windsurf.chatFontSize": "22",
  "windsurf.rememberLastModelSelection": true,
  "windsurf.openRecentConversation": true,
  "files.autoSave": "afterDelay",
  "workbench.iconTheme": "material-icon-theme",
  "database-client.autoSync": true,
  "redhat.telemetry.enabled": true,
  "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
  "git.openRepositoryInParentFolders": "always",
  "editor.formatOnPaste": true,
  "editor.formatOnSave": true,
  "editor.formatOnType": true,
  "terminal.integrated.profiles.windows": {
    "PowerShell": { "source": "PowerShell", "icon": "terminal-powershell" },
    "Command Prompt": {
      "path": ["${env:windir}\\Sysnative\\cmd.exe", "${env:windir}\\System32\\cmd.exe"],
      "args": [],
      "icon": "terminal-cmd"
    },
    "Git Bash": { "source": "Git Bash" },
    "Cmder": { "path": "C:\\Windows\\System32\\cmd.exe", "args": ["/K","C:\\cmder\\vendor\\bin\\vscode_init.cmd"] }
  },
  "terminal.integrated.defaultProfile.windows": "Cmder",
  "python.createEnvironment.trigger": "off",
  "totalTypeScript.hideAllTips": false,
  "totalTypeScript.hideBasicTips": false,
  "editor.largeFileOptimizations": false,
  "workbench.editorAssociations": { "*.jar": "default" },
  "[dockercompose]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.autoIndent": "advanced",
    "editor.quickSuggestions": { "other": true, "comments": false, "strings": true },
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "[github-actions-workflow]": { "editor.defaultFormatter": "redhat.vscode-yaml" },
  "editor.fontSize": 21,
  "cSpell.userWords": ["Faruk"],
  "workbench.colorTheme": "Shades of Purple",
  "workbench.colorCustomizations": {
    "editor.foreground": "#fff", // Editor font color
    "editor.background":"#2e2e4a", //Editor background color
    "sideBar.background": "#2e2e4a", // Background of sidebar
    "sideBar.foreground": "#fff",    // Font color of sidebar
    "sideBar.border": "#2e2e4a",     // Border color of sidebar
    "sideBarTitle.foreground": "#2e2e4a", // Sidebar-of section title-color
    "sideBarSectionHeader.background": "#2e2e4a"  // Section header-color
  },
  "editor.tokenColorCustomizations": {
    "comments": "#A3CB38",
    "keywords": "#ffa801",
    "strings": "##05c46b",
    "numbers": "#0fbcf9",
    "functions": "#5758BB",
    "variables": "#2c003e"
  }

}
