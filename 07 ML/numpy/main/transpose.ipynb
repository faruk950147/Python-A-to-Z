   "source": [
    "# traspose matrix is when we flip the matrix over its diagonal\n",
    "import numpy as np\n",
    "\n",
    "matrix = np.array([[1, 2, 3], [4, 5, 6]])\n",
    "print(\"Original matrix:\")\n",
    "print(matrix)\n",
    "\n",
    "print(\"Transposed matrix:\")\n",
    "print(matrix.transpose())\n"
   ]
  }
 ],
