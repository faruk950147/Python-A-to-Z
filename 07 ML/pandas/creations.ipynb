    "# Simple definition of a pandas DataFrame with some sample data.\n",
    "import pandas as pd\n",
    "data = pd.Series([1, 2, 3, 4, 5])\n",
    "\n",
    "df = pd.DataFrame(data, columns=['col-1'])\n",
    "\n",
    "# add a new column to the DataFrame by applying a function to an existing column\n",
    "df['col-2'] = df['col-1'] ** 2\n",
    "df"
   ]
  }
